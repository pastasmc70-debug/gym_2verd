# Ejemplo de variables de entorno. La app NO lee este archivo sola:
# exportalas en la terminal (ver README) o cargalas en el servicio que la ejecute.
# Los valores con $ van entre comillas simples.
# TODAS son opcionales: sin administrador, la primera vez que abras la app aparece un asistente
# y la clave secreta se genera sola. Lo que se guarde en Configuración manda sobre estas variables.

# GYM_SECRET_KEY='generar-con: python -c "import secrets; print(secrets.token_hex(32))"'
# GYM_ADMIN_USER='admin'   # (van las dos juntas)
# GYM_ADMIN_PASSWORD_HASH='generar-con: python crear_hash.py'

# Opcionales
GYM_NOMBRE='Mi Gimnasio'
# GYM_DIAS_ALERTA=7
# GYM_DB_PATH=/ruta/a/gimnasio.db
# GYM_UPLOAD_DIR=/ruta/a/fotos
# GYM_COOKIE_SECURE=1      # activar cuando se sirva por HTTPS

# Roles y reglas
# Solo compatibilidad: se importan una vez como primera cuenta de recepción. Las demás se crean en la pantalla Usuarios.
# GYM_RECEPCION_USER='recepcion'
# GYM_RECEPCION_PASSWORD_HASH='generar-con: python crear_hash.py recepcion'
# GYM_ACCESO_SIN_PAGO=0        # 1: deja entrar a quien aún no pagó el período inicial
# GYM_PERMITIR_REINGRESO=0     # 1: permite más de un ingreso por día
# GYM_LIMITAR_CLASES_SEMANA=1  # 0: no controla el tope semanal de clases
# GYM_IMPORT_DIR=/ruta/a/importaciones

# GYM_HORAS_ADENTRO=2        # «Adentro ahora (aprox.)»: horas (1 a 12) desde el último ingreso

# Copia de seguridad automática diaria (también se elige en Configuración)
# GYM_BACKUP_DIR=/ruta/a/la/carpeta/de/copias

# Tienda
# GYM_MODULO_TIENDA=1

# Kiosco (pantalla de la puerta; es solo software, no abre molinetes)
# GYM_KIOSCO_CLAVE_HASH='generar-con: python crear_hash.py kiosco'
# GYM_KIOSCO_SONIDO=1
# GYM_KIOSCO_TECLADO=0
# GYM_KIOSCO_MAX_POR_MINUTO=15
# GYM_KIOSCO_SESION_DIAS=30
